// Copy this file to arduino_secrets.h in the same directory and put your own
// network details in it. THAT FILE IS GIT-IGNORED and a pre-commit hook will
// refuse to add it, so your password cannot reach the repository history.
//
//     cp arduino_secrets.h.example arduino_secrets.h
//     $EDITOR arduino_secrets.h
//
// The sketch picks it up automatically via __has_include and falls back to
// placeholders when it is absent, so the example still compiles in CI and for
// anyone who has not made one.
#define SECRET_SSID "your-network-name"
#define SECRET_PASS "your-password"
